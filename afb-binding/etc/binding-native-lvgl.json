{
    "name": "afb-display",
    "port": 1234,
    "alias": [
        "/devtools:/usr/share/afb-ui-devtools/binder"
    ],
    "test":1,
    "monitoring": true,
    "binding": [
        {
            "uid": "display-lvgl",
            "api": "display",
            "path": "${CARGO_TARGET_DIR}debug/libafb_lvgl.so",
            "info": "lvgl embedded display binding",
            "permission": "acl:display:client",
         	"logo": "./afb-binding/etc/tux-evsex150.png",
            "test": 1,
            "display": {
                "x_res": 1920,
                "y_res": 1080,
                "ratio": 1
            }
        }
    ]
}
